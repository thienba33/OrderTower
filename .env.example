# SPDX-License-Identifier: Apache-2.0

# Use ORDERTOWER_DB_PASSWORD below, URL-encoded, in place of the placeholder.
# For a backend running on the host, change postgres to localhost.
DATABASE_URL=postgres://ordertower_app:replace-with-url-encoded-password@postgres:5432/ordertower
POSTGRES_ADMIN_PASSWORD=
ORDERTOWER_DB_PASSWORD=
KEYCLOAK_URL=http://localhost:9080
# URL nội bộ để API lấy tài liệu discovery và JWKS của Keycloak (trong
# Docker Compose là http://keycloak:8080, vì jwks_uri công khai trong
# discovery không tới được từ trong container API).
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

KEYCLOAK_REALM=ordertower
KEYCLOAK_CLIENT_ID=ordertower-web

KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# Local demo users only: set a password in .env before starting Keycloak.
ORDERTOWER_DEMO_PASSWORD=

APISIX_ADMIN_KEY=change-me

S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=example-access-key
S3_SECRET_KEY=example-secret-key
S3_BUCKET=ordertower-chung-tu

OLLAMA_HOST=http://localhost:11434
# Mô hình Ollama dùng cho lớp BI. Điền tên và phiên bản mô hình khi cấu hình.
OLLAMA_MODEL=
