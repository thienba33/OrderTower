# SPDX-License-Identifier: Apache-2.0

# Use ORDERTOWER_DB_PASSWORD below, URL-encoded, in place of the placeholder.
# For a backend running on the host, change postgres to localhost.
DATABASE_URL=postgres://ordertower_app:replace-with-url-encoded-password@postgres:5432/ordertower
POSTGRES_ADMIN_PASSWORD=
ORDERTOWER_DB_PASSWORD=
KEYCLOAK_URL=http://localhost:9080
# URL nội bộ để API lấy tài liệu discovery và JWKS của Keycloak (trong
# Docker Compose là http://keycloak:8080, vì jwks_uri công khai trong
# discovery không tới được từ trong container API).
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

KEYCLOAK_REALM=ordertower
KEYCLOAK_CLIENT_ID=ordertower-web
# Client công khai thứ hai cho ứng dụng Tầng 2 (workspace) dùng PKCE.
KEYCLOAK_PORTAL_CLIENT_ID=ordertower-portal

# Gốc web + Secure cookie. Local HTTP để false; sau TLS ingress đặt true.
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# Local demo users only: set a password in .env before starting Keycloak.
ORDERTOWER_DEMO_PASSWORD=

# Grafana local (prometheus/grafana trong compose).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# OpenBao dev local (MPL 2.0). Root token chỉ dùng cho dev/demo.
OPENBAO_ROOT_TOKEN=dev-root-token
OPENBAO_ENABLED=1
OPENBAO_REQUIRED=0

# Automation scheduler trong API. Job ghi run log + notification, không tự đổi
# trạng thái nghiệp vụ. Đặt AUTOMATION_ENABLED=0 để tắt khi debug.
AUTOMATION_ENABLED=1
AUTOMATION_OUTBOX_INTERVAL_MS=15000
AUTOMATION_SLA_INTERVAL_MS=60000

APISIX_ADMIN_KEY=change-me

S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=example-access-key
S3_SECRET_KEY=example-secret-key
S3_BUCKET=ordertower-chung-tu

# Kiểm dịch file upload. Đặt CLAMAV_ENABLED=false nếu máy không chạy
# được ClamAV; khi bật, CLAMAV_REQUIRED=true sẽ fail-closed nếu clamd lỗi.
CLAMAV_ENABLED=true
CLAMAV_REQUIRED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

OLLAMA_HOST=http://localhost:11434
# Mô hình Ollama dùng cho lớp BI. Điền tên và phiên bản mô hình khi cấu hình.
OLLAMA_MODEL=

# LLM cho AI chuẩn hóa địa chỉ (Cloudflare Workers AI). Chỉ dùng khi đủ
# account + token; không có thì tính năng chạy bằng luật. Không commit
# token vào repo.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Model Workers AI, mặc định @cf/meta/llama-3.1-8b-instruct khi để trống.
CLOUDFLARE_AI_MODEL=
# IT/OT telemetry. Device key chỉ dùng cho dev/demo; production dùng mTLS/HMAC
# và key rotation. Endpoint thiết bị: POST /api/telemetry/readings.
TELEMETRY_DEVICE_KEY=dev-device-key
TELEMETRY_ONLINE_SECONDS=300
TELEMETRY_STALE_SECONDS=1800
