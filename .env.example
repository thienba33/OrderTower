# Sao chép thành .env và điền giá trị thật khi chạy. Không commit tệp .env.
DATABASE_URL=postgres://ordertower:ordertower@localhost:5432/ordertower
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=ordertower
KEYCLOAK_CLIENT_ID=ordertower-web
APISIX_ADMIN_KEY=change-me
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=example-access-key
S3_SECRET_KEY=example-secret-key
S3_BUCKET=ordertower-chung-tu
OLLAMA_HOST=http://localhost:11434
# Mô hình Ollama dùng cho lớp BI. Điền tên và phiên bản mô hình khi cấu hình.
OLLAMA_MODEL=
