{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "compilerOptions": {
    "assets": [
      "workflow/definitions/*.json",
      "inventory/data/*.json",
      "address/data/*.json",
      "db/migrations/*.sql"
    ],
    "deleteOutDir": true
  },
  "sourceRoot": "src"
}
