# Reverse proxy WAF trước API. APISIX vẫn xử lý auth/rate-limit; service này
# chỉ nhận traffic API đã qua APISIX (hoặc gọi trực tiếp để test).
{
  admin off
  auto_https off
  order coraza_waf first
}

:8080 {
  handle /healthz {
    respond "ok" 200
  }

  coraza_waf {
    load_owasp_crs
    directives `
      Include @coraza.conf-recommended
      Include @crs-setup.conf.example
      # API dùng PATCH (sửa đơn, tách địa chỉ) và DELETE, nhưng danh sách
      # phương thức cho phép mặc định của CRS (crs-setup.conf.example)
      # chỉ có GET HEAD POST OPTIONS, nên rule 911100 chặn mọi PATCH
      # với 403 (Anomaly Score 5). Ghi đè danh sách cho đúng phương thức
      # API dùng, trước khi nạp rule 911100. Auth/vai trò vẫn do API
      # kiểm tra; WAF chỉ bỏ chặn phương thức, không bỏ chặn nội dung.
      SecAction "id:100000, phase:1, pass, nolog, setvar:'tx.allowed_methods=GET HEAD POST OPTIONS PATCH DELETE'"
      Include @owasp_crs/*.conf
      SecRuleEngine On
    `
  }

  reverse_proxy api:3001

  # Không bật access log của Caddy: URI public tracking có thể chứa SĐT.
  # Coraza vẫn ghi log "WAF rule violation detected" khi chặn request.
  handle_errors {
    @waf expression `{http.error.message}.startsWith("interruption triggered")`
    respond @waf "Blocked by WAF: {http.error.message}" 403
    respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
  }
}
