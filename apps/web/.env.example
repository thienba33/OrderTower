# Biến môi trường cho app web (chỉ dùng phía server, không có NEXT_PUBLIC)
# Copy thành .env khi chạy local. Không commit file .env thật.

# Keycloak (máy chạy Docker: http://localhost:9080)
KEYCLOAK_URL=http://localhost:9080
KEYCLOAK_REALM=ordertower
KEYCLOAK_CLIENT_ID=ordertower-web
# Cửa API qua APISIX
API_BASE_URL=http://localhost:9080/api
